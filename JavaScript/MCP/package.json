{
  "name": "agentic-ai-testing-framework",
  "version": "1.0.0",
  "description": "Comprehensive framework for testing Agentic AI applications with Playwright. Includes 13+ testing patterns with examples.",
  "main": "src/agent-test-framework.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:basics": "playwright test tests/agent-basics.spec.js",
    "test:advanced": "playwright test tests/agent-advanced.spec.js",
    "test:naukri": "playwright test tests/naukri-automation.spec.js --headed",
    "test:naukri:ui": "playwright test tests/naukri-automation.spec.js --ui",
    "test:naukri:debug": "playwright test tests/naukri-automation.spec.js --debug",
    "test:report": "playwright show-report"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  }
}
